# Copy to .env. Never distribute .env or the data folder with the customer app.
STELEX_HOST=127.0.0.1
STELEX_PORT=4318
STELEX_DATA_DIR=.data

# Local Ollama. Install.bat pulls huihui_ai/qwen3.5-abliterated:9b and creates
# the qwen3.5-abliterated:9b alias used by Stelex. No API key required.
STELEX_AI_BASE_URL=http://127.0.0.1:11434/v1
STELEX_AI_MODELS=qwen3.5-abliterated:9b
STELEX_DEMO_MODE=false

# For a shared, paid service start new accounts with zero credits.
STELEX_INITIAL_CREDITS=0

# Set when serving behind your own HTTPS reverse proxy. Enables Secure cookies
# and validates the intended public origin, without trusting forwarded headers.
# STELEX_PUBLIC_ORIGIN=https://chat.example.com
# Enable only behind your own reverse proxy on this machine. It must append
# the real client IP as the last X-Forwarded-For address (e.g. default Caddy).
# Never enable for arbitrary clients that can directly reach this HTTP port.
# STELEX_TRUST_PROXY_LOOPBACK=true

# Optional: provide a long random admin token through your secret manager.
# If omitted, the server creates a private admin-token.txt in its data folder.
# STELEX_ADMIN_TOKEN=

# Other OpenAI-compatible providers may require a key (server only).
# STELEX_AI_API_KEY=

# Optional per-model entitlements. All referenced models must actually exist.
# tier: 0=Free, 1=Starter, 2=Pro, 3=Max.
# multiplier weights actual provider tokens for Stelex usage units.
# reasoningSupported only for providers/models accepting reasoning_effort.
# STELEX_AI_MODELS=[{"id":"qwen3.5-abliterated:9b","name":"Qwen 3.5 Abliterated 9B","tier":0,"multiplier":1},{"id":"your-installed-reasoning-model","name":"Thinking","tier":2,"multiplier":2,"reasoningSupported":true}]

# Optional real email verification. Without HOST and FROM it stays disabled.
# Once enabled, users must verify their email before chatting.
# STELEX_SMTP_HOST=smtp.example.com
# STELEX_SMTP_PORT=587
# STELEX_SMTP_SECURE=false
# STELEX_SMTP_USER=
# STELEX_SMTP_PASSWORD=
# STELEX_SMTP_FROM=Stelex <accounts@example.com>

# Maximum simultaneous provider calls; queued requests use plan priority.
STELEX_PROVIDER_CONCURRENCY=2

# Image input: add vision:true to a model only after verifying provider support.
# The Windows app detects Ollama /api/show capabilities automatically.

# Private owner authentication (scrypt hash only; never distribute to customers).
# STELEX_ADMIN_CODE_HASH=scrypt:<32-hex-salt>:<128-hex-digest>
# A configured code hash overrides legacy admin tokens.
# Customer desktop enforces disabled administrator routes.
# STELEX_ADMIN_DISABLED=true
